{
  "manifest_version": 3,
  "name": "Pushbullet Reborn (MV3)",
  "version": "0.1.0",
  "description": "A modern Pushbullet client built for Manifest V3.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pushbullet Reborn"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage"]
}
